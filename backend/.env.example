# Cognitive Academy - Master LMS AI Gateway Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ── Admin Lead Notifications ─────────────────────────────────────────────────
# Email via Gmail SMTP
# Use a Gmail App Password (NOT your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=

# ── Security ─────────────────────────────────────────────────────────────────
# Optional password for admin routes when you are NOT on the same computer. Normally leave this empty.
ADMIN_API_TOKEN=
# Comma-separated browser origins allowed to call the API directly (Vercel proxies /api, so usually only dev origins).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Database (enquiries and studio access codes) ─────────────────────────────
# A hosted Postgres database (Neon or Supabase free plan). Use the SAME value on Render and in your
# local backend/.env so the admin on your computer and the live website share one set of data.
# Leave empty to use a local SQLite file (backend/kreomax.db), which is not shared with the live site.
DATABASE_URL=

# ── Admin ────────────────────────────────────────────────────────────────────
# Put this ONLY in your local backend/.env, never on Render. With it on, the admin page works from
# this computer without a password; on the live website admin routes stay switched off.
# ADMIN_LOCAL=1

# Cognitive Academy - Master LMS AI Gateway Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# ── Admin Lead Notifications ─────────────────────────────────────────────────
# Email via Gmail SMTP
# Use a Gmail App Password (NOT your regular Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=

# ── Security ─────────────────────────────────────────────────────────────────
# Required for admin routes (lead list, saving AI keys, test-email).
# Routes stay disabled while this is empty. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
# Comma-separated browser origins allowed to call the API directly (Vercel proxies /api, so usually only dev origins).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Where studio access codes are stored (a JSON file). Use a persistent disk on your host.
# ACCESS_FILE=/data/access_data.json
